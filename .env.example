# CyberSec IPsec VPN Analyzer Configuration
ENVIRONMENT=development
DEBUG=True

# Database (Default fallback to SQLite if PostgreSQL not running)
DATABASE_URL=sqlite:///./cybsec_vpn.db
# For production Docker PostgreSQL:
# DATABASE_URL=postgresql://cybsec:cybsec_secure_pwd@db:5432/cybsec_vpn

# Security & JWT
JWT_SECRET=super-secret-key-change-in-production-min-32-chars-long-abc123xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Storage & Upload Limits
MAX_PCAP_SIZE_MB=100
PCAP_RETENTION_MINUTES=1440
UPLOAD_DIR=./uploads

# AI / ML Models
MODEL_PATH=./ml/models/random_forest_vpn_traffic.joblib

# Privacy & Logging
REDACT_SENSITIVE_LOGS=True
ALLOW_EXTERNAL_AI_PAYLOADS=False
